local function makeSfx(name, id, vol, pitch)
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 0.5
    s.PlaybackSpeed = pitch or 1
    s.Parent = sfxFolder
    return s
end

