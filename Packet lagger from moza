    listeningForKey = true
    KeyBtn.Text = "press keyboard / controller key..."
    tween(KeyBtn, {BackgroundColor3 = ACCENT_DARK}, 0.15)
    playSfx("Keybind")
end)

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if listeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            listeningForKey = false
            applyKeybind(keyToName(input.KeyCode))
            tween(KeyBtn, {BackgroundColor3 = BG_INPUT}, 0.15)
            playSfx("Keybind")
            saveConfig()
        elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
            listeningForKey = false
            toggleGamepadName = input.KeyCode.Name
            toggleGamepadKey = input.KeyCode
            KeyBtn.Text = toggleKeyName .. " / " .. toggleGamepadName
            tween(KeyBtn, {BackgroundColor3 = BG_INPUT}, 0.15)
            playSfx("Keybind")
            saveConfig()
        end
        return
    end

    if input.KeyCode == toggleKey or input.KeyCode == toggleGamepadKey then
        playSfx("Toggle")
        if lagging then stopLagging() else startLagging() end
    end
end)

