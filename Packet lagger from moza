-- ============ AUTO-STEAL MONITOR ============
task.spawn(function()
    local SPEED_THRESHOLD = 25

    while true do
        if autoStealActive then
            local char = LP.Character
            local hasStealItem = false

            if char then
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") then
                        local n = string.lower(child.Name)
                        if n:find("steal") or n:find("cash") or n:find("bag") or n:find("loot") or n:find("brainrot") then
                            hasStealItem = true
                        end
                    end
                end

                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    if humanoid.WalkSpeed < SPEED_THRESHOLD then
                        hasStealItem = true
                    end
                end
            end

            if hasStealItem then
                if not lagging then
                    startLagging()
                end
            else
                if lagging then
                    stopLagging()
                end
            end
        end
        task.wait(0.2)
    end
end)

KeyBtn.MouseButton1Click:Connect(function()
